{
  "name": "Operación del restaurante",
  "short_name": "Operación",
  "description": "Mesas, cocina, domicilios, mensajería y métricas del restaurante en tiempo real.",
  "lang": "es",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#050505",
  "theme_color": "#050505",
  "categories": ["business", "food", "productivity"],
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Mesas", "url": "/piso", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Cocina", "url": "/cocina", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Mensajes", "url": "/mensajes", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}

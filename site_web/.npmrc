# Usa los metadatos y paquetes ya cacheados en el store de pnpm antes de ir a la
# red: las reinstalaciones (y el CI con cache) no vuelven a descargar lo que ya hay.
prefer-offline=true
# No detenerse a pedir confirmacion cuando haya que recrear node_modules
# (bloqueaba scripts y terminales no interactivas).
confirm-modules-purge=false
